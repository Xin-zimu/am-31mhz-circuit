* AM-02.2 stability B, input termination=None
VCC vcc 0 PWL(0 0 1u 5)
R1 vcc b 10k
R2 b 0 10k
CB b 0 100n
Q1 c b e 2N3904
RE1 e 0 1k
RC1 vcc c 1k
COUT c out 100p
RL out 0 10000
CL out 0 10p

.model 2N3904 NPN(Is=6.734f Xti=3 Eg=1.11 Vaf=74.03 Bf=416.4 Ne=1.259
+ Ise=6.734f Ikf=66.78m Xtb=1.5 Br=.7371 Nc=2 Isc=0 Ikr=0 Rc=1
+ Cjc=3.638p Mjc=.3085 Vjc=.75 Fc=.5 Cje=4.493p Mje=.2593 Vje=.75
+ Tr=239.5n Tf=301.2p Itf=.4 Vtf=4 Xtf=2 Rb=10)
.options method=trap maxord=2 reltol=1e-4 trtol=7 temp=27 tnom=27
.control
set num_threads=1
set filetype=binary
save v(out) v(e)
tran 0.5n 250u 0 0.5n
write D:/实验报告文件夹/电路2/simulation/v4_hardware/stage4_rf_oscillator/AM02_2_first_stage_20261113/results/raw/stab_B_open.raw
quit
.endc
.end
