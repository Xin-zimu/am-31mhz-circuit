* AM-02.3 stage S1 standalone
VCCX vcc 0 DC 5
VS in0 0 DC 0 AC 1
* --- S1: EF input buffer + CE + shunt-fed tank + capacitive tap
CIN2 in0 ba_s 1e-07
RB1 vcc ba_s 100000
RB2 ba_s 0 100000
QF vcc ba_s ef 2N3904
REF ef 0 900
CC1 ef bi 1e-09
RBT vcc bi 2700
RBB2 bi 0 1100
QA ca bi ea 2N3904
RAX ea ex 2
REA ex 0 100
CEA ex 0 1e-09
LTANK vcc ca 1.2e-06
CT1 ca rl 2.2e-11
CT2 rl 0 6.8e-11
RLD rl 0 50
CLD rl 0 1e-11
.model 2N3904 NPN(Is=6.734f Xti=3 Eg=1.11 Vaf=74.03 Bf=416.4 Ne=1.259
+ Ise=6.734f Ikf=66.78m Xtb=1.5 Br=.7371 Nc=2 Isc=0 Ikr=0 Rc=1
+ Cjc=3.638p Mjc=.3085 Vjc=.75 Fc=.5 Cje=4.493p Mje=.2593 Vje=.75
+ Tr=239.5n Tf=301.2p Itf=.4 Vtf=4 Xtf=2 Rb=10)
.options method=trap maxord=2 reltol=1e-4 trtol=7 temp=27 tnom=27
.control
set num_threads=1
set filetype=binary
op
ac dec 80 5meg 120meg
write tab_S1.raw
quit
.endc
.end
