* C3 numerical-consistency run: c4_trap_0p125n_2k_rtol1e5
* Circuit identical to c2_two_load.cir; numerical options only.
*   method=trap maxord=2 reltol=1e-5 trtol=7 tmax=0.125n tstep=0.25n tstop=5m tstart=3m rload=2k
VSUP vcc 0 PWL(0 0 1u 5)
* --- crystal Colpitts (unchanged from C1) ---
R1 vcc b 10k
R2 b 0 10k
Q1 vcc b e 2N3904
R3 e 0 4.7k
C1 b e 33p
C2 e 0 33p
C3 vcc 0 100n
C4 vcc 0 10u
CSTRAY b 0 1p
CX0 b 0 3.0p
VXM b xr 0
RM xr xl 30
LM xl xc 0.002637081993366925
CM xc 0 10.0f
* --- emitter follower buffer (unchanged from C1) ---
CIN e bf 1n
RBT vcc bf 10k
RBB bf 0 10k
QB vcc bf ef 2N3904
REB ef 0 330
COUTB ef bo 1n
* --- common-emitter gain stage (unchanged from C1) ---
CG bo bg 10n
RG1 vcc bg 22k
RG2 bg 0 4.7k
QG cg bg eg 2N3904
RCG vcc cg 1k
REG eg 0 56
COUTG cg out 10n
.model 2N3904   NPN(Is=6.734f Xti=3 Eg=1.11 Vaf=74.03 Bf=416.4 Ne=1.259
+               Ise=6.734f Ikf=66.78m Xtb=1.5 Br=.7371 Nc=2 Isc=0 Ikr=0 Rc=1
+               Cjc=3.638p Mjc=.3085 Vjc=.75 Fc=.5 Cje=4.493p Mje=.2593 Vje=.75
+               Tr=239.5n Tf=301.2p Itf=.4 Vtf=4 Xtf=2 Rb=10)
.options method=trap maxord=2 reltol=1e-5 trtol=7 temp=27 tnom=27

RTP2DC out 0 1meg


* RF attenuation/coupling to base; no uncontrolled floating transistor terminal.
RMRF out mrftap 2200
RMRG mrftap 0 10
CMRF mrftap mb 1e-10
* DC-coupled base injection: no duty-dependent coupling-capacitor baseline.
RMT vcc mb 15000
RMB mb 0 3300
RPRE vm mod_env 10000
CENV mod_env 0 4.7e-11
RMINJ mod_env mb 37000
QM mc mb me 2N3904
RMC vcc mc 1000
RME me 0 470
CME me 0 1e-09
* TP3 is the AC-coupled MODULATOR output, not automatically v3.
CMOUT mc tp3 1e-10
RTP3DC tp3 0 1000
* Explicit output follower and final AC-coupled connector.
CBUF tp3 ob 1e-10
ROBT vcc ob 33000
ROBB ob 0 33000
QOB vcc ob oe 2N3904
ROE oe 0 330
COV3 oe tx_drv 10n
ROISO tx_drv v3 1000
LTX v3 ltx_esr 470n
RLTX ltx_esr 0 2.288650248140164
CTX v3 0 51p
* Measurement fixture, NOT a specified antenna or course load.
RTEST v3 0 10000
CTEST v3 0 5e-12
.options method=trap maxord=2 reltol=1e-5 trtol=7 temp=27 tnom=27

* TI LM393 macromodel from installed NI Multisim master database LM393/TI.
* U1A: DIP pins IN+=3 IN-=2 V+=8 GND=4 OUT=1
* U1B: DIP pins IN+=5 IN-=6 V+=8 GND=4 OUT=7
V5 V5 0 5
CDEC V5 0 100n
CBULK V5 0 10u
RPU1 V5 OSC 2.2k
RHT V5 HYST 30k
RHB HYST 0 10k
RHF OSC HYST 20k
RFIX OSC FSET 22k
RVRF FSET RAMP 15288.86443
CT RAMP 0 1n
XU1A HYST RAMP V5 0 OSC LM393_TI
* VDUTY resistor chain: 10k + 10k potentiometer + 4.7k.
RDT V5 DUTY_TOP 10k
RVDT DUTY_TOP DUTY 9623.899007
RVDB DUTY DUTY_BOT 376.1009934
RDB DUTY_BOT 0 4.7k
XU1B DUTY RAMP V5 0 PWM_RAW LM393_TI
RPU2 V5 PWM_RAW 2200
* 20k amplitude potentiometer, wiper at V1, includes specified load.
RVAT PWM_RAW V1 5049.093362306836
RVAB V1 0 14950.906637693164
RINPUT V1 0 1000000
CINPUT V1 0 15p
