        <Box style={{ flexDirection: 'row', marginTop: 16 }}>
          <Text style={{ width: 26, fontSize: 15, color: '#1F4E79' }}>①</Text>
          <Text style={{ flex: 1, fontSize: 16, color: '#333333', lineHeight: 1.55 }}>全链路仿真闭环：v1 → 调幅 → 检波 → v2，幅度倍率 1.204</Text>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 16 }}>
          <Text style={{ width: 26, fontSize: 15, color: '#1F4E79' }}>②</Text>
          <Text style={{ flex: 1, fontSize: 16, color: '#333333', lineHeight: 1.55 }}>三张 KiCad 施工图（原理图、LC 小板、洞洞板布局），ERC 0 错误 0 警告</Text>
        </Box>

        <Box style={{ flexDirection: 'row', marginTop: 16 }}>
          <Text style={{ width: 26, fontSize: 15, color: '#1F4E79' }}>③</Text>
          <Text style={{ flex: 1, fontSize: 16, color: '#333333', lineHeight: 1.55 }}>BOM 36 行，三批采购清单已逐项核对，仅 2 项需替代料</Text>
        </Box>
      </Box>

      <Box style={{ flex: 1, flexDirection: 'column' }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#111111' }}>主要风险与未闭合项</Text>
